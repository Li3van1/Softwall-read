{
  "name": "pdfgrid",
  "short_name": "pdfgrid",
  "description": "PDF-Leser mit Rasteransicht",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#5f7f8f",
  "theme_color": "#00007b",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}